(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Chicken Butter Masala', 'Indulge in the luxurious goodness of our Chicken Butter Masala—a creamy, velvety curry that wraps tender chicken in a rich blend of aromatic spices and fresh tomatoes. Infused with the smoothness of butter and a touch of cream, this dish offers a perfect balance of heat and sweetness. Each bite is a melt-in-your-mouth experience, accompanied by a delicate hint of fenugreek and the warmth of traditional Indian spices. Served with warm naan or steamed rice, it’s an indulgent, comforting dish that promises a burst of flavors in every spoonful.', 200, 'products/image8.webp', 10, '2025-01-07 11:57:06.104777'); args=['Chicken Butter Masala', 'Indulge in the luxurious goodness of our Chicken Butter Masala—a creamy, velvety curry that wraps tender chicken in a rich blend of aromatic spices and fresh tomatoes. Infused with the smoothness of butter and a touch of cream, this dish offers a perfect balance of heat and sweetness. Each bite is a melt-in-your-mouth experience, accompanied by a delicate hint of fenugreek and the warmth of traditional Indian spices. Served with warm naan or steamed rice, it’s an indulgent, comforting dish that promises a burst of flavors in every spoonful.', Decimal('200'), 'products/image8.webp', 10, '2025-01-07 11:57:06.104777']; alias=default
