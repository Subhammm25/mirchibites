(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Chicken Tikka', 'Experience the irresistible allure of our Chicken Tikka, where succulent pieces of chicken are marinated in a blend of yogurt, aromatic spices, and fresh herbs, then char-grilled to perfection. Each bite bursts with smokey flavors and a delicate balance of heat and tang, complemented by a rich, golden crust. Served with a side of mint chutney, the tender chicken offers a delightful contrast between spice and creaminess. This iconic dish promises to take your taste buds on a journey, perfect for those who crave a touch of smoky indulgence.', 225, 'products/image10.jpeg', 10, '2025-01-07 11:58:25.221315'); args=['Chicken Tikka', 'Experience the irresistible allure of our Chicken Tikka, where succulent pieces of chicken are marinated in a blend of yogurt, aromatic spices, and fresh herbs, then char-grilled to perfection. Each bite bursts with smokey flavors and a delicate balance of heat and tang, complemented by a rich, golden crust. Served with a side of mint chutney, the tender chicken offers a delightful contrast between spice and creaminess. This iconic dish promises to take your taste buds on a journey, perfect for those who crave a touch of smoky indulgence.', Decimal('225'), 'products/image10.jpeg', 10, '2025-01-07 11:58:25.221315']; alias=default
