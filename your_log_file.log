(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Afghani Chicken Mandi', 'Experience the rich and aromatic flavors of our Afghani Chicken Mandi, a true masterpiece of ancient culinary tradition. Tender chicken, marinated in a blend of fragrant spices and yogurt, is slow-cooked to perfection, allowing the flavors to infuse every bite. Served on a bed of fluffy, saffron-infused rice, the dish is complemented by the subtle warmth of cardamom, cinnamon, and cloves. With a hint of smokiness and a delicate touch of freshness from herbs, this royal dish promises to transport your taste buds to the heart of Afghan heritage. Perfect for those who savor the blend of spice, tenderness, and tradition in every bite.', 250, 'products/chicken-5940975.jpg', 10, '2025-01-07 12:00:37.009456'); args=['Afghani Chicken Mandi', 'Experience the rich and aromatic flavors of our Afghani Chicken Mandi, a true masterpiece of ancient culinary tradition. Tender chicken, marinated in a blend of fragrant spices and yogurt, is slow-cooked to perfection, allowing the flavors to infuse every bite. Served on a bed of fluffy, saffron-infused rice, the dish is complemented by the subtle warmth of cardamom, cinnamon, and cloves. With a hint of smokiness and a delicate touch of freshness from herbs, this royal dish promises to transport your taste buds to the heart of Afghan heritage. Perfect for those who savor the blend of spice, tenderness, and tradition in every bite.', Decimal('250'), 'products/chicken-5940975.jpg', 10, '2025-01-07 12:00:37.009456']; alias=default
