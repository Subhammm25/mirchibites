(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Rogan Josh', 'Immerse yourself in the rich, aromatic essence of our Rogan Josh, a masterpiece of Kashmiri cuisine. Tender lamb, slow-cooked to perfection, is infused with a vibrant blend of warm spices—cardamom, cinnamon, and cloves—that deliver depth and richness with every bite. The vibrant red hue, derived from the delicate use of Kashmiri chilies, invites you to savor the bold flavors, while a creamy, silky gravy envelops the meat, creating an indulgent, melt-in-your-mouth experience. Paired with steamed rice or naan, Rogan Josh is a luxurious dish that brings a taste of tradition and royalty to your plate.', 280, 'products/Mutton_Rogan_Josh.jpeg', 10, '2025-01-07 11:55:25.317134'); args=['Rogan Josh', 'Immerse yourself in the rich, aromatic essence of our Rogan Josh, a masterpiece of Kashmiri cuisine. Tender lamb, slow-cooked to perfection, is infused with a vibrant blend of warm spices—cardamom, cinnamon, and cloves—that deliver depth and richness with every bite. The vibrant red hue, derived from the delicate use of Kashmiri chilies, invites you to savor the bold flavors, while a creamy, silky gravy envelops the meat, creating an indulgent, melt-in-your-mouth experience. Paired with steamed rice or naan, Rogan Josh is a luxurious dish that brings a taste of tradition and royalty to your plate.', Decimal('280'), 'products/Mutton_Rogan_Josh.jpeg', 10, '2025-01-07 11:55:25.317134']; alias=default
