(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Tandoori Chicken', 'Experience the smoky perfection of our Tandoori Chicken—a classic dish marinated in a rich blend of yogurt, zesty lemon, and a symphony of hand-ground spices. Cooked to perfection in a traditional clay tandoor, each piece boasts a charred, crispy exterior and juicy, tender meat inside. Infused with the irresistible flavors of cumin, paprika, and garam masala, this vibrant dish is as visually appealing as it is delicious. Served with fresh mint chutney and a squeeze of lemon, our Tandoori Chicken promises a mouthwatering journey to the heart of Indian cuisine.', 249, 'products/pexels-mithulvarshan-8156645.jpg', 10, '2025-01-07 11:52:06.635935'); args=['Tandoori Chicken', 'Experience the smoky perfection of our Tandoori Chicken—a classic dish marinated in a rich blend of yogurt, zesty lemon, and a symphony of hand-ground spices. Cooked to perfection in a traditional clay tandoor, each piece boasts a charred, crispy exterior and juicy, tender meat inside. Infused with the irresistible flavors of cumin, paprika, and garam masala, this vibrant dish is as visually appealing as it is delicious. Served with fresh mint chutney and a squeeze of lemon, our Tandoori Chicken promises a mouthwatering journey to the heart of Indian cuisine.', Decimal('249'), 'products/pexels-mithulvarshan-8156645.jpg', 10, '2025-01-07 11:52:06.635935']; alias=default
