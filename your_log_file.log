(0.000) INSERT INTO `home_product` (`name`, `description`, `price`, `image`, `stock`, `created_at`) VALUES ('Drums of Heaven', 'Dive into the divine flavors of our Drums of Heaven—succulent chicken lollipops marinated in a medley of aromatic spices, deep-fried to golden perfection, and coated with a tangy, spicy Indo-Chinese sauce. Each bite offers a perfect balance of crunch and juiciness, delivering a burst of flavor that’s truly unforgettable. Garnished with fresh spring onions, this crowd-pleasing appetizer is a feast for the senses and a heavenly treat for your taste buds. Perfect for every occasion, it’s a dish that’s as irresistible as its name suggests!', 220, 'products/image6.jpg', 10, '2025-01-07 11:54:01.683982'); args=['Drums of Heaven', 'Dive into the divine flavors of our Drums of Heaven—succulent chicken lollipops marinated in a medley of aromatic spices, deep-fried to golden perfection, and coated with a tangy, spicy Indo-Chinese sauce. Each bite offers a perfect balance of crunch and juiciness, delivering a burst of flavor that’s truly unforgettable. Garnished with fresh spring onions, this crowd-pleasing appetizer is a feast for the senses and a heavenly treat for your taste buds. Perfect for every occasion, it’s a dish that’s as irresistible as its name suggests!', Decimal('220'), 'products/image6.jpg', 10, '2025-01-07 11:54:01.683982']; alias=default
